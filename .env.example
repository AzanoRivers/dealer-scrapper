# === API ===
PROJECT_NAME=DealerScrapper
API_VERSION=1.0.0
DEBUG=false
API_KEY=<random_32_char_hex>

# === LLM Provider (principal) ===
# opencode = OpenCode Zen, gateway OpenAI-compatible con un solo API key para
# muchos proveedores/modelos (GLM, GPT, Kimi, DeepSeek...). Ver app/pipeline/reviewer.py.
LLM_PROVIDER=opencode
LLM_MODEL=opencode/glm-5.3-flash
LLM_API_KEY=<opencode_api_key>
LLM_MAX_TOKENS=6000
LLM_TEMPERATURE=0.2
LLM_REASONING_EFFORT=

# === LLM Fallback (emergencia — si el principal no responde en 2 min) ===
# Mismo API key de opencode, otro modelo (GPT en vez de GLM) — así un problema
# puntual con GLM no tira los dos intentos, sin necesitar una key de OpenAI real.
LLM_FALLBACK_PROVIDER=opencode
LLM_FALLBACK_MODEL=opencode/gpt-5.4-mini
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_REASONING_EFFORT=

# === Crawler ===
MAX_CONCURRENT_FETCHES=3
MAX_PAGES_PER_JOB=50
FETCH_TIMEOUT_SECONDS=15
FETCH_RETRIES=3

# === Timeouts y ciclo de vida ===
LLM_WATCHDOG_SECONDS=300
JOB_MAX_DURATION_SECONDS=1800
RESULT_TTL_MINUTES=15

# === Storage ===
JOB_BASE_DIR=/tmp/dealerscrapper

# === Imagenes ===
DOWNLOAD_IMAGES=false
MAX_IMAGE_SIZE_MB=5

# === Auditor ===
AUDIT_COVERAGE_MIN_PERCENT=30
AUDIT_REFETCH_ENABLED=true
AUDIT_MAX_NEW_ROUTES=10

# === API ===
PROJECT_NAME=DealerScrapper
API_VERSION=1.0.0
DEBUG=false
API_KEY=<random_32_char_hex>

# === LLM Provider (principal) ===
# opencode = OpenCode Go, gateway OpenAI-compatible con un solo API key para
# muchos proveedores/modelos (GLM, GPT, Kimi, DeepSeek...). Modelo SIN prefijo
# "opencode/" — la base URL ya es la del plan Go (ver _PROVIDER_URLS en
# app/pipeline/reviewer.py, verificada contra GET /v1/models).
LLM_PROVIDER=opencode
LLM_MODEL=glm-5.3-flash
LLM_API_KEY=<opencode_go_api_key>
LLM_MAX_TOKENS=6000
LLM_TEMPERATURE=0.2
LLM_REASONING_EFFORT=

# === LLM Fallback (emergencia — si el principal no responde en 2 min) ===
# API de OpenAI real (key propia, independiente de opencode) — así si la
# suscripción de OpenCode falla por lo que sea, el fallback no depende de ella.
# No usar reasoning_effort acá salvo que el modelo lo requiera explícitamente:
# con un modelo que razona, si max_tokens no alcanza para razonamiento +
# respuesta, la API devuelve 200 con contenido vacío (se factura igual) y el
# job falla igual que si hubiera sido timeout — ver el log que agrega
# reviewer.py cuando esto pasa (finish_reason + usage).
LLM_FALLBACK_PROVIDER=openai
LLM_FALLBACK_MODEL=gpt-4o-mini
LLM_FALLBACK_API_KEY=<real_openai_api_key>
LLM_FALLBACK_REASONING_EFFORT=

# === Crawler ===
MAX_CONCURRENT_FETCHES=3
MAX_PAGES_PER_JOB=50
FETCH_TIMEOUT_SECONDS=15
FETCH_RETRIES=3

# === Timeouts y ciclo de vida ===
LLM_WATCHDOG_SECONDS=300
JOB_MAX_DURATION_SECONDS=1800
RESULT_TTL_MINUTES=15

# === Storage ===
JOB_BASE_DIR=/tmp/dealerscrapper

# === Imagenes ===
DOWNLOAD_IMAGES=false
MAX_IMAGE_SIZE_MB=5

# === Auditor ===
AUDIT_COVERAGE_MIN_PERCENT=30
AUDIT_REFETCH_ENABLED=true
AUDIT_MAX_NEW_ROUTES=10
